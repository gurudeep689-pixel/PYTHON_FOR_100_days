from abc import ABC,abstractmethod
class animal(ABC):
    @abstractmethod
    def sound(self):
        pass
class Dog(animal):
    def sound(self):
        print("woof")
class Cat(animal):
    def sound(self):
        print("meow")
cat=Cat()
dog=Dog()
print(cat.sound())
print(dog.sound())
